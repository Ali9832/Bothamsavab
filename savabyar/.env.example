# Use only the token belonging to @savabyarbot.
BOT_TOKEN=
BOT_USERNAME=savabyarbot

# Optional public Runflare HTTPS domain. If set, the bot registers a webhook
# at deploy time; if empty, it uses long polling. Use the public domain on 443.
WEBHOOK_URL=

# Serverless (Vercel) webhook authentication. Set the same value in the Vercel
# dashboard; Bale must send it back in the X-Telegram-Bot-Api-Secret-Token
# header. Leave empty only while testing locally.
WEBHOOK_SECRET=

# Obtain the wallet payment token for this bot from Bale @botfather.
# This test token does NOT transfer money; test receipts are clearly labelled.
PAYMENT_PROVIDER_TOKEN=WALLET-TEST-1111111111111111
RECEIPT_CHANNEL=@savabyar

# Stable numeric IDs take precedence. A username bootstrap binds once from a
# trusted private update and never reassigns itself after a username change.
ADMIN_USER_IDS=
ADMIN_BOOTSTRAP_USERNAME=molibden4
ADMIN_PASSWORD=
ADMIN_SESSION_MINUTES=15

# Amounts here and in user input are TOMAN; the API receives RIAL.
MIN_AMOUNT_TOMAN=1000
MAX_AMOUNT_TOMAN=10000000

# Runflare PostgreSQL. When DATABASE_URL is set the bot uses PostgreSQL and
# ignores DATABASE_PATH; when empty it falls back to the local SQLite file.
# Add ?sslmode=require only if the server supports SSL; the Runflare instance
# used here does not, so the option is omitted.
DATABASE_URL=
# postgresql://postgres:PASSWORD@DB_HOST:PORT/DBNAME
DATABASE_PATH=data/savabyar.db

# Set only after a public HTTPS reverse proxy is connected to the local server.
# Empty keeps the existing chat amount-entry flow active.
MINIAPP_URL=
MINIAPP_HOST=127.0.0.1
MINIAPP_PORT=8081
